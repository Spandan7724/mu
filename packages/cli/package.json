{
  "name": "@mu/cli",
  "version": "0.0.1",
  "description": "A general-purpose, extensible AI agent for the terminal",
  "type": "module",
  "bin": {
    "mu": "./dist/mu.js"
  },
  "files": [
    "dist/mu.js",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "bun build src/main.ts --target=bun --minify --outfile dist/mu.js",
    "prepack": "bun run build"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "tui"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "optionalDependencies": {
    "@mu/ripgrep-darwin-arm64": "0.0.1",
    "@mu/ripgrep-linux-x64": "0.0.1",
    "@mu/ripgrep-windows-x64": "0.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@mu/profile-coding": "workspace:*",
    "@mu/tui": "workspace:*",
    "mu": "workspace:*",
    "@mu/core": "workspace:*"
  }
}
