{
  "name": "@mu-agent/browser",
  "version": "0.0.1",
  "description": "Mu browser, a general-purpose browser automation agent for the terminal and TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mu-browser": "./dist/mu-browser.js"
  },
  "files": [
    "dist/mu-browser.js",
    "dist/index.js",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "author": "Spandan Chavan",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@mu/cli-runtime": "workspace:*",
    "@mu/core": "workspace:*",
    "@mu/profile-browser": "workspace:*",
    "@mu/tui": "workspace:*",
    "mu": "workspace:*"
  }
}
