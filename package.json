{
  "name": "@mu/monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "packages/profiles/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "purity": "bun scripts/kernel-purity.ts",
    "ci": "bun run typecheck && bun run lint && bun test && bun run purity",
    "build": "bun build packages/cli/src/main.ts --compile --minify --outfile dist/mu",
    "build:npm": "bun run --cwd packages/cli build",
    "pack:npm": "cd packages/cli && bun pm pack --destination ../../dist",
    "build:linux": "bun build packages/cli/src/main.ts --compile --minify --target=bun-linux-x64-baseline --outfile dist/mu-linux-x64",
    "build:macos": "bun build packages/cli/src/main.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/mu-darwin-arm64"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
