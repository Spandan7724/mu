{
  "name": "@mu/monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/profiles/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "purity": "bun scripts/kernel-purity.ts",
    "ci": "bun run typecheck && bun run lint && bun test && bun run purity"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
